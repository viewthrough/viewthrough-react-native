{
  "name": "@viewthrough/sdk",
  "version": "0.1.1",
  "description": "Viewthrough SDK — installs, onboarding, paywall and checkout events from your app, batched and offline-safe. Works in React Native, Expo, web and Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viewthrough/viewthrough-react-native.git"
  },
  "homepage": "https://viewthrough.app/docs/sdk",
  "keywords": ["viewthrough", "analytics", "attribution", "react-native", "expo", "ugc", "tiktok"],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "react-native": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm -w run sdk:build",
    "prepublishOnly": "pnpm -w run sdk:build"
  },
  "engines": {
    "node": ">=18"
  }
}
